# Sao chép thành apps/web/.env.local rồi chỉnh. Mọi biến đều có mặc định.

# classifier = theo Kế hoạch (POST /api/predict -> nhãn + xác suất)
# pipeline   = theo spec.md (POST /api/analyses -> điểm tin cậy + tuyên bố + bằng chứng)
VITE_API_MODE=classifier

# true = dùng dữ liệu giả lập, không cần backend
VITE_USE_MOCK=false

# Tiền tố API. Khi chạy dev, Vite proxy /api sang http://localhost:3000
VITE_API_BASE=/api

# Thời gian chờ tối đa (ms). Mặc định 30000 (classifier) / 120000 (pipeline)
# VITE_REQUEST_TIMEOUT_MS=30000

# Số ký tự tối thiểu của nội dung (nên khớp ngưỡng loại văn bản ngắn bên tiền xử lý)
# VITE_MIN_CHARS=50
