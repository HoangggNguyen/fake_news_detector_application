# AI service
AI_SERVICE_URL=http://localhost:8000
MODEL_PATH=ml/artifacts/classifier.joblib
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=http://localhost:11434

# Evidence providers (lớp đối chiếu bằng chứng web; EVIDENCE_CHECK=false để tắt)
EVIDENCE_CHECK=true
# Số tuyên bố tối đa được tìm nguồn mỗi lần phân tích (mỗi tuyên bố = 1 lượt Tavily)
MAX_CLAIMS=5
GOOGLE_FACTCHECK_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=

# API and local services
PORT=3000
DATABASE_URL=mysql://mysql:mysql@localhost:3306/fakenews
REDIS_URL=redis://localhost:6379
RATE_LIMIT_PER_MIN=10
USE_BULLMQ=false
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=openai/gpt-oss-120b
# Câu hỏi gợi ý do Groq viết khi không có mẫu khớp (mặc định tắt)
FOLLOW_UP_QUESTION=false
OLLAMA_MODEL=qwen2.5:7b
