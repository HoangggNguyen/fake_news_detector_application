{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/api/src/index.ts",
      "runtimeArgs": ["--import", "tsx"],
      "cwd": "${workspaceFolder}/apps/api",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    },
    {
      "name": "Debug AI Service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "python": "${workspaceFolder}/apps/ai-service/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/apps/ai-service",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Debug Backend + AI",
      "configurations": ["Debug API", "Debug AI Service"],
      "stopAll": true
    }
  ]
}